{
  "framework": "vite",
  "installCommand": "npm install --prefix web",
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://ai-nutrition-api-production.up.railway.app/health"
    },
    {
      "source": "/api/:path*",
      "destination": "https://ai-nutrition-api-production.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
