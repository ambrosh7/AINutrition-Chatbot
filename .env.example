# Copy to .env and fill in secrets locally. Never commit .env.
# On Railway: set these in the service Variables UI (not in Vercel).

# Groq (OpenAI-compatible). Only provider for Milestone 1 chat.
MODEL_PROVIDER=groq
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
# Allowed: openai/gpt-oss-120b (default) | qwen/qwen3.6-27b
GROQ_MODEL=openai/gpt-oss-120b

TEMPERATURE=0.2
# Local / ephemeral Railway SQLite (history resets on redeploy without a volume).
# Optional volume: sqlite:////data/app.db  |  or a Postgres DATABASE_URL.
DATABASE_URL=sqlite:///./data/app.db
PROMPT_VERSION=m1-v2
# Local Vite. Production via Vercel rewrites can leave this blank.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HISTORY_MESSAGE_LIMIT=20
